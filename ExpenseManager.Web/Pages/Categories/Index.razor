@page "/categories"
@using ExpenseManager.Shared.Models.SearchModels
@using ExpenseManager.Web.Components

<PageTitle>Categories</PageTitle>

<h2 class="mb-4">Categories</h2>

<!-- Search and Add -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div class="col-4">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search categories..." 
                       @bind="SearchModel.SearchText" @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDown">
                <button class="btn btn-outline-secondary" type="button" @onclick="SearchCategories">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="NavigateToAdd"><i class="fas fa-plus"></i> Add</button>
    </div>
</div>

<!-- Categories Table -->
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th style="width: 100px;"></th>
            </tr>
        </thead>
        <tbody>
            @if (ExpenseCategories != null && ExpenseCategories.Items != null && ExpenseCategories.Items.Any())
            {
                @foreach (var category in ExpenseCategories.Items)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td>@category.Title</td>
                        <td>@category.Description</td>
                        <td>
                            <a href="/categories/createoredit/@category.Id" class="btn btn-sm btn-primary me-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button class="btn btn-sm btn-danger" title="Delete" @onclick="() => ConfirmDelete(category)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">No categories found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (ExpenseCategories != null)
{
    <Pagination PaginatedList="@ExpenseCategories" 
                OnPageChangedCallback="OnPageChanged"
                OnPageSizeChangedCallback="OnPageSizeChanged" />
}

<!-- Delete Confirmation -->
<ConfirmBox IsVisible="@IsDeleteConfirmVisible" 
            Message="@DeleteConfirmMessage" 
            OnConfirm="DeleteCategory" 
            OnCancel="CancelDelete" />