@page "/categories"
@using ExpenseManager.Shared.Models.SearchModels

<PageTitle>Categories</PageTitle>

<h2 class="mb-4">Categories</h2>

<!-- Search and Add -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div class="col-4">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search categories..." @bind="SearchModel.SearchText" @bind:event="oninput">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="NavigateToAdd"><i class="fas fa-plus"></i> Add</button>
    </div>
</div>

<!-- Categories Table -->
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @if (ExpenseCategories != null && ExpenseCategories.Items != null && ExpenseCategories.Items.Any())
            {
                @foreach (var category in ExpenseCategories.Items)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td>@category.Title</td>
                        <td>@category.Description</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3">No categories found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>