@page "/expenses"
@using ExpenseManager.Shared.Models.SearchModels
@using ExpenseManager.Web.Components

<PageTitle>Expenses</PageTitle>

<h2 class="mb-4">Expenses</h2>

<!-- Search and Add -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div class="col-4">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search expenses..." 
                       @bind="SearchModel.SearchText" @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDown">
                <button class="btn btn-outline-secondary" type="button" @onclick="SearchExpenses">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="NavigateToAdd"><i class="fas fa-plus"></i> Add Expense</button>
    </div>
</div>

<!-- Expenses Table -->
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Payment Type</th>
                <th>Amount</th>
                <th>Notes</th>
                <th style="width: 100px;"></th>
            </tr>
        </thead>
        <tbody>
            @if (Expenses != null && Expenses.Items != null && Expenses.Items.Any())
            {
                @foreach (var expense in Expenses.Items)
                {
                    <tr>
                        <td>@expense.ExpenseDate.ToShortDateString()</td>
                        <td>@expense.ExpenseCategory</td>
                        <td>@expense.PaymentType</td>
                        <td>@expense.Amount.ToString("C")</td>
                        <td>@(expense.Notes?.Length > 50 ? expense.Notes.Substring(0, 50) + "..." : expense.Notes)</td>
                        <td>
                            <a href="/expenses/createoredit/@expense.Id" class="btn btn-sm btn-primary me-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button class="btn btn-sm btn-danger" title="Delete" @onclick="() => ConfirmDelete(expense)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">No expenses found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Expenses != null)
{
    <Pagination PaginatedList="@Expenses" 
                OnPageChangedCallback="OnPageChanged"
                OnPageSizeChangedCallback="OnPageSizeChanged" />
}

<!-- Delete Confirmation -->
<ConfirmBox IsVisible="@IsDeleteConfirmVisible" 
            Message="@DeleteConfirmMessage" 
            OnConfirm="DeleteExpense" 
            OnCancel="CancelDelete" />
